rules_version = '2';

// Call-Driven CRM security rules — flat access.
// Access is gated by an allow-list keyed on the signed-in Google email:
// `allowlist/{email}` → { companyId }. No entry = no access. Every allow-listed
// user has equal, full access to their own company's data (including managing
// the allow-list). Users in a different company see nothing of this one.
// Cloud Functions / the seed use the Admin SDK and bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function emailKey() {
      return request.auth.token.email;
    }
    function allowlistRef() {
      return /databases/$(database)/documents/allowlist/$(emailKey());
    }
    function isAllowed() {
      return request.auth != null && request.auth.token.email != null && exists(allowlistRef());
    }
    // A member may belong to several companies. We support both the list form
    // (companyIds) and the legacy single companyId so existing entries keep
    // working without a migration.
    function entryCompanies(data) {
      return ('companyIds' in data) ? data.companyIds : [data.companyId];
    }
    function myCompanies() {
      return entryCompanies(get(allowlistRef()).data);
    }
    function sameCompany(companyId) {
      return isAllowed() && (companyId in myCompanies());
    }

    // Allow-list. A user may read their own entry, and any allow-listed user
    // may read and manage entries that share a company with them (the Users
    // screen). Flat trust within a company: hasAny means the editor touches an
    // entry only when they themselves belong to one of its companies, so no one
    // can grant or revoke access to a company they are not a member of.
    match /allowlist/{email} {
      allow read: if request.auth != null
                  && (request.auth.token.email == email
                      || (isAllowed() && entryCompanies(resource.data).hasAny(myCompanies())));
      allow create, update: if isAllowed() && entryCompanies(request.resource.data).hasAny(myCompanies());
      allow delete: if isAllowed() && entryCompanies(resource.data).hasAny(myCompanies());
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      // Members may edit their own company's settings (name, language, zone,
      // auto-close/retention knobs). The company is created by provisioning
      // (Admin SDK), so create/delete stay closed.
      allow create, delete: if false;
      allow update: if sameCompany(companyId);
    }

    // DIDs are read by the company, but written only by the manageDid function
    // (Admin SDK), so every number is normalised to E.164 before it is stored.
    match /dids/{didId} {
      allow read: if sameCompany(resource.data.companyId);
      allow write: if false;
    }

    match /emailRules/{ruleId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create, update: if sameCompany(request.resource.data.companyId);
      allow delete: if sameCompany(resource.data.companyId);
    }

    // Calls are written by Cloud Functions (Admin SDK). The one exception is
    // re-filing: an agent may move a call to another ticket of the same
    // company (only ticketId changes), mirroring how events move.
    match /calls/{callId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create, delete: if false;
      allow update: if sameCompany(resource.data.companyId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketId']);
    }

    // Timeline events are INTERACTIONS: a call, email or meeting. Notes are a
    // separate thing (see /notes). Agents may log a manual interaction not
    // captured automatically (a call on another phone, an email, an in-person
    // meeting); it must be marked source 'manual' so it can never masquerade as
    // an engine-captured event, and limited to that safe set of types. All
    // other events are written by Cloud Functions (Admin SDK) only.
    match /events/{eventId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if sameCompany(request.resource.data.companyId)
                    && request.resource.data.source == 'manual'
                    && request.resource.data.type in ['call', 'email', 'meeting']
                    && request.resource.data.customerId is string
                    && request.resource.data.summary is string;
      // An event may be re-filed to a different ticket (Customer ▸ Ticket ▸
      // Call): only ticketId may change, never the event's content, so history
      // stays intact while it moves between tickets.
      allow update: if sameCompany(resource.data.companyId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketId']);
      allow delete: if false;
    }

    // Notes: free-text commentary, separate from interaction events. A note
    // always hangs off a customer and may be narrowed to a ticket, call or
    // event. Stamped with the author's email (unforgeable); the author may
    // delete their own, and no one edits a note in place.
    match /notes/{noteId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if sameCompany(request.resource.data.companyId)
                    && request.resource.data.author == request.auth.token.email
                    && request.resource.data.customerId is string
                    && request.resource.data.text is string;
      allow update: if false;
      allow delete: if sameCompany(resource.data.companyId)
                    && resource.data.author == request.auth.token.email;
    }

    match /ringing/{callId} {
      allow read: if sameCompany(resource.data.companyId);
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if sameCompany(request.resource.data.companyId);
      allow update: if sameCompany(resource.data.companyId)
                    && request.resource.data.companyId == resource.data.companyId;
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if sameCompany(request.resource.data.companyId);
      allow update: if sameCompany(resource.data.companyId)
                    && request.resource.data.companyId == resource.data.companyId;
      allow delete: if false;
    }

    // One-time secrets: an allow-listed user may create a sealed secret; the
    // value is read and consumed only by the revealSecret function (Admin SDK).
    match /secrets/{id} {
      allow create: if isAllowed()
                    && request.resource.data.status == 'sealed'
                    && request.resource.data.secret is string;
      allow read, update, delete: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Copy to `.env.local`. For emulator development the defaults below are enough;
# no real Firebase project or credentials are needed.

# Point the SPA at the local Auth + Firestore emulators.
VITE_USE_EMULATORS=true

# Real project config (only needed when NOT using emulators).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=demo-simple-crm
VITE_FIREBASE_AUTH_DOMAIN=demo-simple-crm.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app-id
